generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // Note: for migrations we configured `prisma/prisma.config.cjs`.
  // Keep the DATABASE_URL here so `prisma generate` and client work in dev.
  url = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.VarChar(128)
  passwordHash  String
  name          String?   @db.VarChar(100)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  gameWins      GameHistory[] @relation("UserWins")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(128)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  @db.VarChar(30)
  provider          String  @db.VarChar(30)
  providerAccountId String  @db.VarChar(128)

  refresh_token     String? @db.Text
  access_token      String? @db.Text
  id_token          String? @db.Text
  token_type        String?
  scope             String?
  expires_at        Int?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   @db.VarChar(128)
  token      String   @unique @db.VarChar(128)   
  expires    DateTime
}



model GameHistory {
  id         String   @id @default(cuid())
  roomId     String
  playedAt   DateTime @default(now())
  winnerId   String?  // User.id du gagnant
  winner     User?    @relation("UserWins", fields: [winnerId], references: [id])
  playersJson String  @db.Text // JSON.stringify([{id, name, points}])
}

model Room {
  id             String   @id @default(uuid())
  hostId         String?  // id user (si tu veux), sinon null
  started        Boolean  @default(false)
  drawerId       String?  // user id choisi comme dessinateur (nullable)
  drawerSocketId String?  // socket id choisi (fallback if anonymous)
  // current word for the active round (nullable)
  currentWordId  String?  
  currentWord    Prompt?  @relation(fields: [currentWordId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Prompt {
  id        String   @id @default(uuid())
  text      String   @db.VarChar(200)
  difficulty String? 
  category  String?
  createdAt DateTime @default(now())

  // back-relation for rooms that use this prompt
  rooms     Room[]
}


